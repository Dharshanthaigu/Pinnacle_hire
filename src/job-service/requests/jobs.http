  "requiredDomainExpertise": ["SaaS", "Fintech"]
}

### Accept job (seeker)
PATCH {{jobBaseUrl}}/{{jobId}}/accept
Authorization: Bearer {{seekerToken}}

### Poster accepts the candidate — status moves to "confirmed"
PATCH {{jobBaseUrl}}/{{jobId}}/accept-candidate
Authorization: Bearer {{posterToken}}

### Poster reviews the candidate's profile (fetches from auth-service)
GET {{jobBaseUrl}}/{{jobId}}/seeker-profile
Authorization: Bearer {{posterToken}}

### Poster submits review — moves status to "verifying"
PATCH {{jobBaseUrl}}/{{jobId}}/review-candidate
Authorization: Bearer {{posterToken}}
Content-Type: application/json

{
  "posterEmail": "poster@test.com"
}

### Poster schedules the meeting — moves status to "connecting"
PATCH {{jobBaseUrl}}/{{jobId}}/schedule-meeting
Authorization: Bearer {{posterToken}}
Content-Type: application/json

{
  "meetingDate": "{{$datetime iso8601 1 d}}",
  "meetingLink": "https://meet.example.com/test-room"
}

### Seeker confirms attendance
PATCH {{jobBaseUrl}}/{{jobId}}/confirm-attendance
Authorization: Bearer {{seekerToken}}

### Confirm completion — seeker first
PATCH {{jobBaseUrl}}/{{jobId}}/confirm
Authorization: Bearer {{seekerToken}}

### Confirm completion — poster second
### Auto-finalizes: status -> completed, commission set (flat, 5000), reputation
### updated, invoice flag set on poster.
PATCH {{jobBaseUrl}}/{{jobId}}/confirm
Authorization: Bearer {{posterToken}}

### Poster pays the resulting invoice
PATCH {{jobBaseUrl}}/{{jobId}}/pay-invoice
Authorization: Bearer {{posterToken}}